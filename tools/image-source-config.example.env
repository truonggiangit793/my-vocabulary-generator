# Provider order. Openverse/Flickr is retained only as a last-resort fallback.
IMAGE_SOURCE_PRIORITY=unsplash,pinterest,pexels,pixabay,openverse

# Obtain keys from each provider's official developer portal. Do not commit a
# populated version of this file.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Pinterest's public developer API does not provide a general Pin-search
# endpoint for this workflow. Set this only to an approved endpoint that
# accepts {query} and returns { results: [{ url, width, height, title, tags }] }.
PINTEREST_IMAGE_SEARCH_URL=
PINTEREST_ACCESS_TOKEN=
